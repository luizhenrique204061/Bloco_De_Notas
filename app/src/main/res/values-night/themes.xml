<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Tema Escuro) -->
    <style name="Base.Theme.BlocoDeNotas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Toolbar e fundo pretos absolutos -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/verde_claro</item>

        <!-- Desativa o clareamento automático cinza do Material 3 -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Ícones e títulos da Toolbar brancos -->
        <item name="android:textColorPrimary">@color/white</item>

        <!-- Barra de Status preta com ícones claros/cinzas do sistema -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Barra de Navegação inferior preta -->
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.BlocoDeNotas" parent="Base.Theme.BlocoDeNotas" />

    <style name="Theme.BlocoDeNotas.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TEXTO">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TEXTO_LOGIN">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BACKGROUND_CARD_VIEW">
        <item name="android:background">@color/white</item>
    </style>

    <style name="TelaPrincipal" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.BlocoDeNotas.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />
</resources>